# Sunucu portu
PORT=3000

# Meta webhook doğrulama token'ı (GET /webhook hub.verify_token ile karşılaştırılır)
META_VERIFY_TOKEN=guclu_bir_verify_token

# Meta Graph API erişim token'ı (mesaj gönderme + kullanıcı profili)
META_ACCESS_TOKEN=meta_page_access_token

# Meta App Secret (X-Hub-Signature-256 HMAC doğrulaması için)
META_APP_SECRET=meta_app_secret

# SerpApi anahtarı (Google Lens araması)
SERPAPI_KEY=serpapi_api_key

# PostgreSQL bağlantısı
DATABASE_URL=postgresql://user:password@localhost:5432/biraderagentic?schema=public

# Sonuçların filtreleneceği e-ticaret domain listesi (virgülle ayrılmış)
ALLOWED_MARKETPLACE_DOMAINS=trendyol.com,hepsiburada.com,n11.com,amazon.com.tr,ciceksepeti.com,pttavm.com
